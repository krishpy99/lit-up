{
  "name": "@lit-up/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "sim": "tsx scripts/sim.ts",
    "test:integration": "LIT_RECONNECT_GRACE_S=999 LIT_BOT_THINK_MS=0 LIT_POST_BOT_ACTION_DELAY_MS=0 tsx --test --test-force-exit tests/integration/*.test.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.24",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.5",
    "@lit-up/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.16.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
